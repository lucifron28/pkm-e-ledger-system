# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only official samples and source records
data-sources/**/*.xlsx
data-sources/**/*.xls
data-sources/**/*.csv
data-sources/**/*.pdf
!data-sources/README.md

# local SQLite databases
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm

# local file uploads (receipts, documents)
/uploads/*
!/uploads/.gitkeep

# local backups & test databases
/backups/
tests/**/*.db
tests/**/*.db-journal
tests/**/*.db-wal
tests/**/*.db-shm

# local code intelligence and assistant tooling state
/.codegraph/
/.gemini/

