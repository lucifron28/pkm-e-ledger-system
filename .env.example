# -----------------------------------------------------------------------------
# PKM e-Ledger System — Production Environment Settings
# -----------------------------------------------------------------------------

# Execution environment (production or development)
NODE_ENV=production

# Server Port
PORT=3000

# Base public application URL (must be set in production, e.g. http://192.168.1.100:3000 or http://eledger.mauban.gov)
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# Database connection URL pointing to the local SQLite database
# Note: For production local VM setups, it is recommended to store this file 
# in a persistent directory outside the build container or project directory.
# Example: file:C:/eledger-data/dev.db
DATABASE_URL="file:./prisma/dev.db"
