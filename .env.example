# -----------------------------------------------------------------------------
# PKM e-Ledger System — Production Environment Settings
# -----------------------------------------------------------------------------

# Execution environment (production or development)
NODE_ENV=production

# Server Port
PORT=3000

# Base public application URL (must be set in production, e.g. http://192.168.1.100:3000 or http://eledger.mauban.gov)
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# Local database connection URL.
# For a production local VM, store this file in a persistent directory outside
# the build container or project directory.
DATABASE_URL="file:./prisma/dev.db"

# Vercel/Turso runtime database.
# When both values exist, the application uses Turso through Prisma's libSQL
# adapter. Never commit the auth token.
# TURSO_DATABASE_URL="libsql://your-database.turso.io"
# TURSO_AUTH_TOKEN="your-turso-token"
