# PKM e-Ledger System environment template
# Local default uses SQLite. Cloud deployment uses Turso and private Vercel Blob.

NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local SQLite database. Prisma resolves this relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Set both values for Vercel/Turso. Never commit filled values.
# TURSO_DATABASE_URL="<FILL_ME_TURSO_DATABASE_URL>"
# TURSO_AUTH_TOKEN="<FILL_ME_TURSO_AUTH_TOKEN>"

# Local attachment storage is the default. Vercel deployment must use vercel-blob.
ATTACHMENT_STORAGE_PROVIDER="local"
NEXT_PUBLIC_ATTACHMENT_STORAGE_PROVIDER="local"
# BLOB_READ_WRITE_TOKEN="<FILL_ME_VERCEL_BLOB_TOKEN>"

# Required for deployment/production seed runs. Local development uses a safe,
# non-production fallback only when this value is absent and NODE_ENV is not production.
# DEMO_PASSWORD="<FILL_ME_STRONG_DEMO_PASSWORD>"
RESET_DEMO_PASSWORDS="false"
